{
  "name": "legacylift-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test"
  },
  "dependencies": {
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.1.4",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.0"
  }
}
