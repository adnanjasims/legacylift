{
  "name": "legacylift-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "test": "vitest run",
    "lint": "eslint src vite.config.ts vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write src vite.config.ts vitest.config.ts index.html",
    "format:check": "prettier --check src vite.config.ts vitest.config.ts index.html"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.45.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
